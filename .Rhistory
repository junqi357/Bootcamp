    MyPlotData$Count,
    xlab = "Observation index",  # Label the x-axis
    ylab = "Individuals per species per quadrat",  # Label the y-axis
    main = "Pound Hill species abundance"  # Add a plot title
)
boxplot(
    Count ~ Cultivation,
    data = MyPlotData,  # Use the Pound Hill data
    xlab = "Cultivation treatment",
    ylab = "Individuals per species per quadrat",
    main = "Species abundance by cultivation treatment"
)
dev.off()  # Close the current graphics device
plot(
