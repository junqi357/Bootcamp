MyPlotData <- read.csv("results/pound_hill_long_tidy.csv")
table(MyPlotData$Cultivation)  # Check the number of records in each group
range(MyPlotData$Count)  # Check the minimum and maximum counts
par(mfrow = c(1, 3))  # Arrange three plots side by side

breaks <- seq(
    -0.5,
    max(MyPlotData$Count) + 0.5,
    by = 1
)  # Use the same bin boundaries for all groups

for (group in c("march", "may", "october")) {

    hist(
        MyPlotData$Count[MyPlotData$Cultivation == group],
        breaks = breaks,
        xlim = c(0, max(MyPlotData$Count)),
        main = group,
        xlab = "Individuals per species per quadrat",
        ylab = "Frequency"
    )
}
